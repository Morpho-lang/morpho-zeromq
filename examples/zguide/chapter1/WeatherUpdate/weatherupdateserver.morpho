// Weather Update server (ZGuide Ch.1). Start this first, then the client:
//   morpho6 examples/zguide/chapter1/WeatherUpdate/weatherupdateserver.morpho
//   morpho6 examples/zguide/chapter1/WeatherUpdate/weatherupdateclient.morpho
// Binds Publisher socket to tcp://*:5556
// Publishes random weather updates

import zeromq

var publisher = ZMQPublisher("tcp://*:5556")

while (true) {
    var zipcode = randomint(99951)
    var temperature = randomint(215)-80 
    var humidity = randomint(50)+10

    publisher.send("${zipcode} ${temperature} ${humidity}") 
}
