// REQ/REP client. Run the server first in another terminal:
//   morpho6 examples/reqrep/server.morpho
//   morpho6 examples/reqrep/client.morpho

import zeromq

print "Starting req/rep client..."

var req = ZMQRequest("tcp://127.0.0.1:5555") 
print req 

for (i in 1..5) {
  req.send("Hello ${i}") 
  var a = req.receive() 
  print "Client received: ${a}"
}

print "Ending req/rep client..."
